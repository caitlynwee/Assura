# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:dev@localhost:5432/assura

# ─── Filesystem (HTML snapshots only) ─────────────────────────────────────────
# Versioned HTML snapshots stay on disk (not in DB)
DATA_DIR=../data

# ─── Web app ──────────────────────────────────────────────────────────────────
WEB_BASE_URL=http://localhost:3000

# ─── Mailpit SMTP ─────────────────────────────────────────────────────────────
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025

# ─── Hermes AI ────────────────────────────────────────────────────────────────
HERMES_API_KEY=

# ─── Scraper ──────────────────────────────────────────────────────────────────
SCRAPER_PORT=8100
SCRAPER_RATE_LIMIT_DELAY=2.0
