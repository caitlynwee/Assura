# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:dev@localhost:5432/assura

# ─── DeepSeek AI (used by scraper for plan data extraction) ───────────────────
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat

# ─── Jina Reader (web + PDF scraping, free tier works without a key) ──────────
# Get a key at https://jina.ai for higher rate limits
JINA_API_KEY=

# ─── Firecrawl (web search for PDF brochure + product page URLs) ──────────────
# Get a key at https://firecrawl.dev — free tier: 500 searches/month
FIRE_CRAWL_API_KEY=

# ─── Scraper ──────────────────────────────────────────────────────────────────
SCRAPER_PORT=8100
SCRAPER_RATE_LIMIT_DELAY=2.0

# ─── Supabase Storage (stored brochure PDFs) — optional; keyless = upload skipped ──
# Reuses the web app's Supabase project. Leave blank to disable stored copies
# (the scrape still succeeds, stored_doc_url just stays empty). The config also
# accepts NEXT_PUBLIC_SUPABASE_URL for the url. Keep the service-role key
# server-only; never prefix it NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DOCUMENTS_BUCKET=documents
