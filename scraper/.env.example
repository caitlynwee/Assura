# ─── Data directory ───────────────────────────────────────────────────────────
# Path to shared /data directory (relative to scraper/ dir)
DATA_DIR=../data

# ─── Web app ──────────────────────────────────────────────────────────────────
WEB_BASE_URL=http://localhost:3000

# ─── Mailpit SMTP ─────────────────────────────────────────────────────────────
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025

# ─── DeepSeek AI (used by scraper for plan data extraction) ───────────────────
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat

# ─── Scraper ──────────────────────────────────────────────────────────────────
SCRAPER_PORT=8100
SCRAPER_RATE_LIMIT_DELAY=2.0
