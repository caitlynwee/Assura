# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:dev@localhost:5432/assura

# ─── Web app ──────────────────────────────────────────────────────────────────
WEB_BASE_URL=http://localhost:3000
INTERNAL_API_SECRET=dev-internal-key

# ─── Mailpit SMTP ─────────────────────────────────────────────────────────────
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025

# ─── DeepSeek AI (used by scraper for plan data extraction) ───────────────────
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat

# ─── Scraper ──────────────────────────────────────────────────────────────────
SCRAPER_PORT=8100
SCRAPER_RATE_LIMIT_DELAY=2.0
