# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:dev@localhost:5432/assura

# ─── DeepSeek AI (used by scraper for plan data extraction) ───────────────────
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat

# ─── Jina Reader (web + PDF scraping, free tier works without a key) ──────────
# Get a key at https://jina.ai for higher rate limits
JINA_API_KEY=

# ─── Supabase Storage (for uploading PDF brochures) ──────────────────────────
# Same values as in web/.env.local — bucket "source-docs" must exist in Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Firecrawl (web search for PDF brochure + product page URLs) ──────────────
# Get a key at https://firecrawl.dev — free tier: 500 searches/month
FIRE_CRAWL_API_KEY=

# ─── Scraper ──────────────────────────────────────────────────────────────────
SCRAPER_PORT=8100
SCRAPER_RATE_LIMIT_DELAY=2.0
