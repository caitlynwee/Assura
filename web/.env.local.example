# ─── Supabase Auth ────────────────────────────────────────────────────────────
# Project URL and anon (public) key — intentionally browser-exposed by design
# (the anon key is safe under Supabase RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Add <URL>/auth/callback to Supabase Auth's allowed redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Service-role key — SERVER ONLY. Full admin access. NEVER prefix NEXT_PUBLIC_,
# never expose to the browser. Used only by the demo-user seed + metadata sync.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy/unused: the edge verifies access tokens with Supabase's published JWKS.
# Safe to leave empty; never prefix this with NEXT_PUBLIC_.
SUPABASE_JWT_SECRET=

# ─── DeepSeek AI ──────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=

# ─── Supabase PostgreSQL ──────────────────────────────────────────────────────
# URL-encode special characters in the password. Never commit the real value.
DATABASE_URL=

# ─── Service URLs ─────────────────────────────────────────────────────────────
SCRAPER_URL=http://localhost:8100
INTERNAL_API_SECRET=dev-internal-key
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
