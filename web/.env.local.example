# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_random_secret

NEXTAUTH_URL=http://localhost:3000

# Supabase PostgreSQL direct connection string.
# Do not commit the real value. URL-encode special characters in the password.
DATABASE_URL=

# ─── Hermes AI ────────────────────────────────────────────────────────────────
HERMES_API_KEY=

# ─── Scraper server ───────────────────────────────────────────────────────────
SCRAPER_URL=http://localhost:8100

# ─── Mailpit SMTP ─────────────────────────────────────────────────────────────
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
