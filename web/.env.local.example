# ─── Supabase Auth ────────────────────────────────────────────────────────────
# Project URL and anon (public) key — intentionally browser-exposed by design
# (the anon key is safe under Supabase RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Full admin access. NEVER prefix NEXT_PUBLIC_,
# never expose to the browser. Used only by the demo-user seed + metadata sync.
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret (HS256) — SERVER ONLY. Used by the edge middleware to VERIFY the
# Supabase access-token signature locally (no network round-trip) so app_metadata
# (tier) cannot be forged. Supabase dashboard → Settings → API → JWT Secret.
# NEVER prefix NEXT_PUBLIC_.
SUPABASE_JWT_SECRET=

# ─── NextAuth (LEGACY — no longer used; Supabase Auth replaced it) ────────────
# Kept only to avoid confusing older setups; safe to remove.
# AUTH_SECRET=replace_with_random_secret
# NEXTAUTH_URL=http://localhost:3000

# ─── DeepSeek AI ──────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=

# ─── Supabase PostgreSQL ──────────────────────────────────────────────────────
# URL-encode special characters in the password. Never commit the real value.
DATABASE_URL=

# ─── Service URLs ─────────────────────────────────────────────────────────────
SCRAPER_URL=http://localhost:8100
INTERNAL_API_SECRET=dev-internal-key
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
