# Copy this file to .env and fill in the values before running docker compose up.
#
#   cp .env.example .env
#
# This file is read automatically by docker-compose.yml for variable substitution.
# Never commit .env — it is gitignored.

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Deepseek AI API key
DEEPSEEK_API_KEY=

# Supabase PostgreSQL direct connection string.
# Do not commit the real value. URL-encode special characters in the password.
DATABASE_URL=
