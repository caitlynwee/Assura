# Copy this file to .env and fill in the values before running docker compose up.
#
#   cp .env.example .env
#
# Never commit .env or real credentials.

INTERNAL_API_SECRET=dev-internal-key
DEEPSEEK_API_KEY=

# Stripe test-mode billing. Put real values in .env, never in this tracked template.
# Use an sk_test_ key and a recurring test-mode price_ ID. `./dev.sh up-stripe`
# obtains and injects the local webhook signing secret automatically. Set
# STRIPE_WEBHOOK_SECRET manually only when starting the app without that command.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Scraper configuration
FIRE_CRAWL_API_KEY=
DEBUG_SCRAPER=

# Supabase direct PostgreSQL connection string.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.otjcvcoeiasmaubadcmp:bKJrrlocx9fQYS0Y@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ─── Supabase Auth ────────────────────────────────────────────────────────────
# From the Supabase dashboard → Project Settings → API keys.
# Supabase's newer key format labels these "Publishable key" and "Secret key"
# (equivalent to the older "anon" and "service_role" keys respectively).
#   Publishable key  → NEXT_PUBLIC_SUPABASE_ANON_KEY  (browser-safe, exposed by design)
#   Secret key       → SUPABASE_SERVICE_ROLE_KEY      (server-only — NEVER expose, never commit)
# The Project URL is on the same page (Project Settings → API / Data API).
# IMPORTANT: use the bare project host ONLY — https://<ref>.supabase.co
# Do NOT append /rest/v1/ or any path or trailing slash; the Supabase client
# adds its own paths (/auth/v1/..., /rest/v1/...). A path here causes 404s.
NEXT_PUBLIC_SUPABASE_URL=https://otjcvcoeiasmaubadcmp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im90amN2Y29laWFzbWF1YmFkY21wIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI0Mjc2NDksImV4cCI6MjEwODAwMzY0OX0.TSyhZCiu5t6tD-6fqfXUPak0WVlXluvSLjuURoP5yWU
# Base URL used for Supabase email confirmation callbacks. Add
# <URL>/auth/callback to Supabase Auth's allowed redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Service-role key — SERVER ONLY. Full admin access. NEVER prefix NEXT_PUBLIC_,
# never expose to the browser. Used only by the demo-user seed + metadata sync.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im90amN2Y29laWFzbWF1YmFkY21wIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MjQyNzY0OSwiZXhwIjoyMTA4MDAzNjQ5fQ.rMQny5x_sRh9Op0WkKfVatXK1C3WcN17p8dwekNJTjM

# Edge middleware verifies the Supabase access token locally.
# NOTE: the edge now verifies via Supabase's published JWKS (ES256/RS256), so a
# shared HS256 secret is NOT required. This var is kept only for reference and
# is unused by the current JWKS verification path — safe to leave empty.
SUPABASE_JWT_SECRET=46b64550-6bc6-43af-9711-054427d65fd3